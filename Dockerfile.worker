# Use Microsoft's Playwright Python image (browsers pre-installed)
FROM mcr.microsoft.com/playwright/python:v1.48.0-noble

# Set working directory
WORKDIR /app

# Environment variables for Playwright
ENV PYTHONUNBUFFERED=1
# Tell Playwright to skip browser download (browsers already in base image)
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Copy requirements and install Python packages from browser-service
COPY browser-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy browser-service code
COPY browser-service/ .

# Start RQ worker instead of main.py
CMD ["rq", "worker", "--url", "${REDIS_URL}", "browser-automation"]
